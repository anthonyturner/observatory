{
  "name": "observatory",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others --names api,web \"npm:api\" \"ng serve\"",
    "api": "node --watch server/main.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "node --test \"server/**/*.spec.ts\"",
    "typecheck:server": "tsc -p server",
    "lint": "ng lint",
    "usage:import-history": "node server/usage/import-history.ts",
    "agents:import-history": "node server/agents/import-history.ts",
    "arch:scan": "node server/architecture/scan-cli.ts",
    "push": "node server/push.ts",
    "queue": "node server/queue/queue-cli.ts",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "imapflow": "^2.2.1",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.5.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
